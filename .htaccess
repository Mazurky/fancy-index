# ENABLE DIRECTORY VIEWS
Options +Indexes

# MIME type for SVG icons
AddType image/svg+xml svg svgz
AddEncoding gzip svgz


# ==========================================================================
# Security Configuration
# ==========================================================================

# Block hidden path components; allow only standard ACME challenge tokens.
RewriteEngine On
RewriteRule "^(?!\.well-known/acme-challenge/[A-Za-z0-9_-]+$)(?:[^/]+/)*\." - [F]

# Protect .htaccess and other sensitive files
<Files ~ "^\.">
  <IfVersion < 2.3>
    order allow,deny
    deny from all
  </IfVersion>
  <IfVersion >= 2.3>
    Require all denied
  </IfVersion>
</Files>

# Prevent access to backup files
<FilesMatch "\.(bak|backup|old|orig|save|swp|tmp)$">
  <IfVersion < 2.3>
    order allow,deny
    deny from all
  </IfVersion>
  <IfVersion >= 2.3>
    Require all denied
  </IfVersion>
</FilesMatch>

# Security headers (if mod_headers is available)
<IfModule mod_headers.c>
  # Prevent MIME type sniffing
  Header set X-Content-Type-Options "nosniff"
  # Enable XSS filtering
  Header set X-XSS-Protection "1; mode=block"
  # Clickjacking protection (adjust as needed)
  Header set X-Frame-Options "SAMEORIGIN"
  # Referrer policy
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ==========================================================================
# Directory Indexing Configuration
# ==========================================================================

<IfModule mod_autoindex.c>

  # ========================================================================
  # Index Options
  # ========================================================================
  # 
  # FancyIndexing    - Enable fancy directory listings
  # HTMLTable        - Use HTML table for layout (required for our CSS)
  # SuppressHTMLPreamble - We provide our own HTML in header.html
  # FoldersFirst     - Show directories before files
  # VersionSort      - Natural sorting (file1, file2, file10 instead of file1, file10, file2)
  # NameWidth=*      - Auto-size name column
  # DescriptionWidth=* - Auto-size description column
  # XHTML            - Generate XHTML-compliant output
  # IconsAreLinks    - Make icons clickable links
  # IgnoreCase       - Case-insensitive sorting
  # SuppressRules    - Don't add horizontal rules
  # TrackModified    - Return Last-Modified header based on directory contents
  # Charset=UTF-8    - Ensure proper character encoding
  # Type=text/html   - Ensure HTML content type
  # IconHeight=18 IconWidth=18 - Consistent icon dimensions
  # 
  IndexOptions FancyIndexing HTMLTable SuppressHTMLPreamble FoldersFirst VersionSort NameWidth=* DescriptionWidth=* XHTML IconsAreLinks IgnoreCase SuppressRules TrackModified Charset=UTF-8 Type=text/html IconHeight=18 IconWidth=18

  # Default sort order
  IndexOrderDefault Ascending Name

  # Link to our custom stylesheet
  IndexStyleSheet /fancy-index/style.css

  # Custom header file (contains opening HTML, head, and opening body)
  HeaderName /fancy-index/header.html

  # Custom footer file (contains closing HTML and script)
  ReadmeName /fancy-index/footer.html

  # ========================================================================
  # Files to Ignore
  # ========================================================================
  
  IndexIgnoreReset ON
  IndexIgnore .ftpquota .DS_Store .git .gitignore .gitattributes .svn .hg fancy-index webui .htaccess .htpasswd *.bak *.backup *.old *.orig *.swp *.tmp *~ \#*\#

  # Icons: one line per SVG, ordered to preserve specific matches.
  DefaultIcon /fancy-index/icons/file.svg
  # Assets retain the upstream MIT license in icons/LICENSE-vscode-icons.txt.

  AddIcon /fancy-index/icons/parent-directory.svg ".."
  AddIcon /fancy-index/icons/directory.svg "^^DIRECTORY^^"
  AddIcon /fancy-index/icons/github.svg ".github"
  AddIcon /fancy-index/icons/node_modules.svg "node_modules"
  AddIcon /fancy-index/icons/file.svg "^^BLANKICON^^"
